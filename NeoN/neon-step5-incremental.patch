+// SPDX-FileCopyrightText: 2026 NeoN authors
+//
+// SPDX-License-Identifier: MIT
+
+#define CATCH_CONFIG_RUNNER
+#include "catch2_common.hpp"
+
+#include "NeoN/NeoN.hpp"
+
+#include <cmath>
+
+namespace fvcc = NeoN::finiteVolume::cellCentred;
+using NeoN::scalar;
+
+namespace
+{
+
+template<typename T>
+auto makeVol(const NeoN::Executor& exec, const NeoN::UnstructuredMesh& mesh, const std::string& name, T v)
+{
+    fvcc::VolumeField<T> f(
+        exec, name, mesh, fvcc::createCalculatedBCs<fvcc::VolumeBoundary<T>>(mesh)
+    );
+    NeoN::fill(f.internalVector(), v);
+    NeoN::fill(f.boundaryData().value(), v);
+    return f;
+}
+
+auto makeFlux(const NeoN::Executor& exec, const NeoN::UnstructuredMesh& mesh, scalar v)
+{
+    fvcc::SurfaceField<scalar> f(
+        exec, "phi", mesh, fvcc::createCalculatedBCs<fvcc::SurfaceBoundary<scalar>>(mesh)
+    );
+    NeoN::fill(f.internalVector(), v);
+    NeoN::fill(f.boundaryData().value(), v);
+    return f;
+}
+
+struct Result
+{
+    std::vector<scalar> value;
+    std::vector<scalar> valueFraction;
+};
+
+Result evaluate(
+    const NeoN::Executor& exec,
+    const NeoN::UnstructuredMesh& mesh,
+    const NeoN::Dictionary& dict,
+    const fvcc::BoundaryContext* ctx,
+    scalar internal
+)
+{
+    auto boundary = fvcc::VolumeBoundaryFactory<scalar>::create(
+        dict.get<std::string>("type"), mesh, dict, 0
+    );
+    auto field = NeoN::Field<scalar>(exec, mesh.nCells(), mesh.boundaryMesh().offset());
+    NeoN::fill(field.internalVector(), internal);
+    if (ctx)
+        boundary->correctBoundaryCondition(field, *ctx);
+    else
+        boundary->correctBoundaryCondition(field);
+    auto [vH, fH] = NeoN::copyToHosts(field.boundaryData().value(), field.boundaryData().valueFraction());
+    Result r;
+    for (auto v : vH.view(boundary->range())) r.value.push_back(v);
+    for (auto v : fH.view(boundary->range())) r.valueFraction.push_back(v);
+    return r;
+}
+
+} // namespace
+
+TEST_CASE("compressible total pressure, total temperature, subsonicSupersonicPressureOutlet")
+{
+    auto [execName, exec] = GENERATE(allAvailableExecutor());
+    auto mesh = NeoN::createSingleCellMesh(exec);
+
+    const scalar gamma = 1.4;
+    const scalar psi = 1.2; // 1/(R T)
+    const NeoN::Vec3 u {3.0, 4.0, 0.0}; // |U|^2 = 25
+    const scalar gM1ByG = (gamma - 1) / gamma;
+
+    auto U = makeVol<NeoN::Vec3>(exec, mesh, "U", u);
+    auto psiField = makeVol<scalar>(exec, mesh, "thermo:psi", psi);
+    auto gammaField = makeVol<scalar>(exec, mesh, "gamma", gamma);
+    auto inflow = makeFlux(exec, mesh, -1.0);
+    auto outflow = makeFlux(exec, mesh, 1.0);
+
+    auto context = [&](const fvcc::SurfaceField<scalar>& phi)
+    {
+        fvcc::BoundaryContext ctx;
+        ctx.insert("phi", phi);
+        ctx.insert("U", U);
+        ctx.insert("thermo:psi", psiField);
+        ctx.insert("gamma", gammaField);
+        return ctx;
+    };
+
+    SECTION("totalPressure with psi and gamma " + execName)
+    {
+        NeoN::Dictionary dict;
+        dict.insert("type", std::string("totalPressure"));
+        dict.insert("p0", scalar(1e5));
+        dict.insert("psi", std::string("thermo:psi"));
+        dict.insert("gamma", gamma);
+
+        const auto ctxIn = context(inflow);
+        const scalar expected = 1e5 / std::pow(1 + 0.5 * psi * gM1ByG * 25.0, 1 / gM1ByG);
+        for (auto v : evaluate(exec, mesh, dict, &ctxIn, 0).value)
+            REQUIRE(v == Catch::Approx(expected));
+
+        const auto ctxOut = context(outflow);
+        for (auto v : evaluate(exec, mesh, dict, &ctxOut, 0).value)
+            REQUIRE(v == Catch::Approx(1e5));
+    }
+
+    SECTION("totalTemperature " + execName)
+    {
+        NeoN::Dictionary dict;
+        dict.insert("type", std::string("totalTemperature"));
+        dict.insert("T0", scalar(300));
+        dict.insert("psi", std::string("thermo:psi"));
+        dict.insert("gamma", gamma);
+
+        const auto ctxIn = context(inflow);
+        for (auto v : evaluate(exec, mesh, dict, &ctxIn, 0).value)
+            REQUIRE(v == Catch::Approx(300 / (1 + 0.5 * psi * gM1ByG * 25.0)));
+
+        const auto ctxOut = context(outflow);
+        for (auto v : evaluate(exec, mesh, dict, &ctxOut, 0).value)
+            REQUIRE(v == Catch::Approx(300));
+
+        for (auto v : evaluate(exec, mesh, dict, nullptr, 0).value)
+            REQUIRE(v == Catch::Approx(300));
+    }
+
+    SECTION("subsonicSupersonicPressureOutlet " + execName)
+    {
+        NeoN::Dictionary dict;
+        dict.insert("type", std::string("subsonicSupersonicPressureOutlet"));
+        dict.insert("p0", scalar(2.0));
+        dict.insert("psi", std::string("thermo:psi"));
+
+        // c = sqrt(gamma/psi) = 1.08 < |U| = 5: supersonic, zero gradient.
+        {
+            const auto ctxIn = context(inflow);
+            const auto r = evaluate(exec, mesh, dict, &ctxIn, 7.0);
+            for (auto v : r.value) REQUIRE(v == Catch::Approx(7.0));
+            for (auto f : r.valueFraction) REQUIRE(f == Catch::Approx(0.0));
+        }
+
+        // Subsonic: a small velocity.
+        auto Uslow = makeVol<NeoN::Vec3>(exec, mesh, "U", NeoN::Vec3 {0.3, 0.4, 0.0});
+        fvcc::BoundaryContext ctx;
+        ctx.insert("phi", inflow);
+        ctx.insert("U", Uslow);
+        ctx.insert("thermo:psi", psiField);
+        ctx.insert("gamma", gammaField);
+        {
+            const auto r = evaluate(exec, mesh, dict, &ctx, 7.0);
+            for (auto v : r.value) REQUIRE(v == Catch::Approx(2.0 / (1 + psi * 0.25 * 0.5)));
+            for (auto f : r.valueFraction) REQUIRE(f == Catch::Approx(1.0));
+        }
+        fvcc::BoundaryContext ctxOut;
+        ctxOut.insert("phi", outflow);
+        ctxOut.insert("U", Uslow);
+        ctxOut.insert("thermo:psi", psiField);
+        ctxOut.insert("gamma", gammaField);
+        {
+            const auto r = evaluate(exec, mesh, dict, &ctxOut, 7.0);
+            for (auto v : r.value) REQUIRE(v == Catch::Approx(2.0));
+        }
+    }
+}
