+// SPDX-FileCopyrightText: 2026 NeoN authors
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <Kokkos_Core.hpp>
+
+#include "NeoN/fields/field.hpp"
+#include "NeoN/finiteVolume/cellCentred/boundary/volumeBoundaryFactory.hpp"
+#include "NeoN/finiteVolume/cellCentred/boundary/boundaryContext.hpp"
+#include "NeoN/finiteVolume/cellCentred/fields/surfaceField.hpp"
+#include "NeoN/finiteVolume/cellCentred/fields/volumeField.hpp"
+#include "NeoN/mesh/unstructured/unstructuredMesh.hpp"
+#include "NeoN/core/parallelAlgorithms.hpp"
+
+namespace NeoN::finiteVolume::cellCentred::volumeBoundary
+{
+
+namespace detail
+{
+
+// Per face, c = sqrt(gamma/psi):
+//   |U| <  c (subsonic):   fixed value p0 / (1 + 0.5 psi magSqr(U) (1 - pos(phi)))
+//   |U| >= c (supersonic): zero gradient
+// pos(phi) is 1 for phi > 0 only, as in the original. Without the fields (hasFields == false)
+// every face is a fixed value p0.
+inline void setSubsonicSupersonicPressureValue(
+    Field<NeoN::scalar>& domainVector,
+    const UnstructuredMesh& mesh,
+    std::pair<localIdx, localIdx> range,
+    NeoN::scalar p0,
+    bool hasFields,
+    View<const NeoN::scalar> boundaryFlux,
+    View<const Vec3> boundaryVelocity,
+    View<const NeoN::scalar> boundaryPsi,
+    View<const NeoN::scalar> boundaryGamma
+)
+{
+    const auto internalV = domainVector.internalVector().view();
+    auto [refGradV, valueV, valueFractionV, refValueV, ownersV] = views(
+        domainVector.boundaryData().refGrad(),
+        domainVector.boundaryData().value(),
+        domainVector.boundaryData().valueFraction(),
+        domainVector.boundaryData().refValue(),
+        mesh.boundaryMesh().faceOwners()
+    );
+
+    NeoN::parallelFor(
+        domainVector.exec(),
+        range,
+        NEON_LAMBDA(const localIdx i) {
+            [[maybe_unused]] const View<const NeoN::scalar> flux = boundaryFlux;
+            [[maybe_unused]] const View<const Vec3> velocity = boundaryVelocity;
+            [[maybe_unused]] const View<const NeoN::scalar> psi = boundaryPsi;
+            [[maybe_unused]] const View<const NeoN::scalar> gamma = boundaryGamma;
+
+            NeoN::scalar valueFraction = NeoN::scalar(1);
+            NeoN::scalar refValue = p0;
+            if (hasFields)
+            {
+                const Vec3 u = velocity[i];
+                const NeoN::scalar magSqrU = u[0] * u[0] + u[1] * u[1] + u[2] * u[2];
+                const NeoN::scalar c = Kokkos::sqrt(gamma[i] / psi[i]);
+                if (Kokkos::sqrt(magSqrU) < c)
+                {
+                    const NeoN::scalar notOut =
+                        flux[i] > NeoN::scalar(0) ? NeoN::scalar(0) : NeoN::scalar(1);
+                    refValue =
+                        p0 / (NeoN::scalar(1) + psi[i] * magSqrU * NeoN::scalar(0.5) * notOut);
+                }
+                else
+                {
+                    valueFraction = NeoN::scalar(0);
+                }
+            }
+
+            valueFractionV[i] = valueFraction;
+            refValueV[i] = refValue;
+            refGradV[i] = NeoN::scalar(0);
+            valueV[i] =
+                valueFraction * refValue + (NeoN::scalar(1) - valueFraction) * internalV[ownersV[i]];
+        },
+        "setSubsonicSupersonicPressureValue"
+    );
+}
+
+} // namespace detail
+
+// subsonicSupersonicPressureOutlet (hybridCentralSolvers): a mixed pressure condition that is the
+// compressible total pressure p0/(1 + 0.5 psi |U|^2 (1 - pos(phi))) on subsonic faces and zero
+// gradient on supersonic faces (|U| >= c, c = sqrt(gamma/psi)). phi, U, psi and gamma are looked
+// up by name in the BoundaryContext (dictionary keys phi, U, psi, gamma; defaults "phi", "U",
+// "psi", "gamma"); gamma is a field, as the original takes it from the thermophysical model.
+// Without them the patch is a fixedValue at p0. Not modelled: a non-uniform p0.
+template<typename ValueType>
+class SubsonicSupersonicPressureOutlet :
+    public VolumeBoundaryFactory<ValueType>::template Register<
+        SubsonicSupersonicPressureOutlet<ValueType>>
+{
+    using Base = VolumeBoundaryFactory<ValueType>::template Register<
+        SubsonicSupersonicPressureOutlet<ValueType>>;
+
+public:
+
+    using Base::correctBoundaryCondition;
+
+    // fixesValue = false: supersonic faces are zero gradient.
+    SubsonicSupersonicPressureOutlet(
+        const UnstructuredMesh& mesh, const Dictionary& dict, localIdx patchID
+    )
+        : Base(mesh, dict, patchID, {.assignable = true, .fixesValue = false}), mesh_(mesh),
+          p0_(dict.get<NeoN::scalar>("p0")),
+          phiName_(dict.contains("phi") ? dict.get<std::string>("phi") : std::string("phi")),
+          uName_(dict.contains("U") ? dict.get<std::string>("U") : std::string("U")),
+          psiName_(dict.contains("psi") ? dict.get<std::string>("psi") : std::string("psi")),
+          gammaName_(
+              dict.contains("gammaField") ? dict.get<std::string>("gammaField")
+                                          : std::string("gamma")
+          )
+    {}
+
+    virtual void correctBoundaryCondition(Field<ValueType>& domainVector) final
+    {
+        detail::setSubsonicSupersonicPressureValue(
+            domainVector, mesh_, this->range(), p0_, false, {}, {}, {}, {}
+        );
+    }
+
+    virtual void
+    correctBoundaryCondition(Field<ValueType>& domainVector, const BoundaryContext& ctx) final
+    {
+        if (!(ctx.hasSurfaceScalar(phiName_) && ctx.hasVector(uName_) && ctx.hasScalar(psiName_)
+              && ctx.hasScalar(gammaName_)))
+        {
+            correctBoundaryCondition(domainVector);
+            return;
+        }
+        detail::setSubsonicSupersonicPressureValue(
+            domainVector,
+            mesh_,
+            this->range(),
+            p0_,
+            true,
+            ctx.surfaceScalarField(phiName_).boundaryData().value().view(),
+            ctx.vectorFieldPtr(uName_).boundaryData().value().view(),
+            ctx.scalarFieldPtr(psiName_).boundaryData().value().view(),
+            ctx.scalarFieldPtr(gammaName_).boundaryData().value().view()
+        );
+    }
+
+    static std::string name() { return "subsonicSupersonicPressureOutlet"; }
+
+    std::string getName() const override { return name(); }
+
+    static std::string doc()
+    {
+        return "Compressible total pressure p0 on subsonic faces, zero gradient on supersonic "
+               "faces. Needs phi, U, psi and gamma in the BoundaryContext; without them it is a "
+               "fixedValue at p0.";
+    }
+
+    static std::string schema() { return "none"; }
+
+    std::unique_ptr<VolumeBoundaryFactory<ValueType>> clone() const final
+    {
+        return std::make_unique<SubsonicSupersonicPressureOutlet>(*this);
+    }
+
+private:
+
+    const UnstructuredMesh& mesh_;
+    NeoN::scalar p0_;
+    std::string phiName_;
+    std::string uName_;
+    std::string psiName_;
+    std::string gammaName_;
+};
+
+} // namespace NeoN::finiteVolume::cellCentred::volumeBoundary
