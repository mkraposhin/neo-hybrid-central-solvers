+// SPDX-FileCopyrightText: 2026 NeoN authors
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <Kokkos_Core.hpp>
+
+#include "NeoN/fields/field.hpp"
+#include "NeoN/finiteVolume/cellCentred/boundary/volumeBoundaryFactory.hpp"
+#include "NeoN/finiteVolume/cellCentred/boundary/boundaryContext.hpp"
+#include "NeoN/finiteVolume/cellCentred/fields/surfaceField.hpp"
+#include "NeoN/finiteVolume/cellCentred/fields/volumeField.hpp"
+#include "NeoN/mesh/unstructured/unstructuredMesh.hpp"
+#include "NeoN/core/parallelAlgorithms.hpp"
+
+namespace NeoN::finiteVolume::cellCentred::volumeBoundary
+{
+
+namespace detail
+{
+
+// T = T0 / (1 + 0.5 psi gM1ByG (1 - pos0(phi)) magSqr(U)), gM1ByG = (gamma - 1)/gamma.
+// Without flux, velocity or psi (hasFields == false) every face gets T0.
+inline void setTotalTemperatureValue(
+    Field<NeoN::scalar>& domainVector,
+    std::pair<localIdx, localIdx> range,
+    NeoN::scalar T0,
+    NeoN::scalar gamma,
+    bool hasFields,
+    View<const NeoN::scalar> boundaryFlux,
+    View<const Vec3> boundaryVelocity,
+    View<const NeoN::scalar> boundaryPsi
+)
+{
+    auto [refGradV, valueV, valueFractionV, refValueV] = views(
+        domainVector.boundaryData().refGrad(),
+        domainVector.boundaryData().value(),
+        domainVector.boundaryData().valueFraction(),
+        domainVector.boundaryData().refValue()
+    );
+    const NeoN::scalar gM1ByG = (gamma - NeoN::scalar(1)) / gamma;
+
+    NeoN::parallelFor(
+        domainVector.exec(),
+        range,
+        NEON_LAMBDA(const localIdx i) {
+            [[maybe_unused]] const View<const NeoN::scalar> flux = boundaryFlux;
+            [[maybe_unused]] const View<const Vec3> velocity = boundaryVelocity;
+            [[maybe_unused]] const View<const NeoN::scalar> psi = boundaryPsi;
+
+            NeoN::scalar T = T0;
+            if (hasFields && flux[i] < NeoN::scalar(0))
+            {
+                const Vec3 u = velocity[i];
+                const NeoN::scalar magSqrU = u[0] * u[0] + u[1] * u[1] + u[2] * u[2];
+                T = T0 / (NeoN::scalar(1) + NeoN::scalar(0.5) * psi[i] * gM1ByG * magSqrU);
+            }
+
+            valueFractionV[i] = NeoN::scalar(1);
+            refValueV[i] = T;
+            refGradV[i] = NeoN::scalar(0);
+            valueV[i] = T;
+        },
+        "setTotalTemperatureValue"
+    );
+}
+
+} // namespace detail
+
+// totalTemperature fixes the total temperature T0 of a stream entering the domain: the static
+// temperature is T0 on outflow and T0/(1 + 0.5 psi (gamma - 1)/gamma magSqr(U)) on inflow, as
+// OpenFOAM's totalTemperature. phi, U and psi are looked up by name in the BoundaryContext
+// (dictionary keys phi, U, psi; defaults "phi", "U", "psi"); gamma is required. Without them the
+// patch is a fixedValue at T0. Not modelled: a non-uniform T0.
+template<typename ValueType>
+class TotalTemperature :
+    public VolumeBoundaryFactory<ValueType>::template Register<TotalTemperature<ValueType>>
+{
+    using Base =
+        VolumeBoundaryFactory<ValueType>::template Register<TotalTemperature<ValueType>>;
+
+public:
+
+    using Base::correctBoundaryCondition;
+
+    TotalTemperature(const UnstructuredMesh& mesh, const Dictionary& dict, localIdx patchID)
+        : Base(mesh, dict, patchID, {.assignable = true, .fixesValue = true}),
+          T0_(dict.get<NeoN::scalar>("T0")), gamma_(dict.get<NeoN::scalar>("gamma")),
+          phiName_(dict.contains("phi") ? dict.get<std::string>("phi") : std::string("phi")),
+          uName_(dict.contains("U") ? dict.get<std::string>("U") : std::string("U")),
+          psiName_(dict.contains("psi") ? dict.get<std::string>("psi") : std::string("psi"))
+    {
+        NF_ASSERT(gamma_ > NeoN::scalar(0), "totalTemperature: gamma must be positive");
+    }
+
+    virtual void correctBoundaryCondition(Field<ValueType>& domainVector) final
+    {
+        detail::setTotalTemperatureValue(
+            domainVector, this->range(), T0_, gamma_, false, {}, {}, {}
+        );
+    }
+
+    virtual void
+    correctBoundaryCondition(Field<ValueType>& domainVector, const BoundaryContext& ctx) final
+    {
+        if (!(ctx.hasSurfaceScalar(phiName_) && ctx.hasVector(uName_) && ctx.hasScalar(psiName_)))
+        {
+            correctBoundaryCondition(domainVector);
+            return;
+        }
+        detail::setTotalTemperatureValue(
+            domainVector,
+            this->range(),
+            T0_,
+            gamma_,
+            true,
+            ctx.surfaceScalarField(phiName_).boundaryData().value().view(),
+            ctx.vectorFieldPtr(uName_).boundaryData().value().view(),
+            ctx.scalarFieldPtr(psiName_).boundaryData().value().view()
+        );
+    }
+
+    static std::string name() { return "totalTemperature"; }
+
+    std::string getName() const override { return name(); }
+
+    static std::string doc()
+    {
+        return "Total-temperature patch: T0 on outflow, T0/(1 + 0.5 psi (gamma-1)/gamma |U|^2) "
+               "on inflow. Needs phi, U and psi in the BoundaryContext; without them it is a "
+               "fixedValue at T0.";
+    }
+
+    static std::string schema() { return "none"; }
+
+    std::unique_ptr<VolumeBoundaryFactory<ValueType>> clone() const final
+    {
+        return std::make_unique<TotalTemperature>(*this);
+    }
+
+private:
+
+    NeoN::scalar T0_;
+    NeoN::scalar gamma_;
+    std::string phiName_;
+    std::string uName_;
+    std::string psiName_;
+};
+
+} // namespace NeoN::finiteVolume::cellCentred::volumeBoundary
