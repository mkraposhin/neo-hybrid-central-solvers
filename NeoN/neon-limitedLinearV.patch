+// SPDX-FileCopyrightText: 2026 NeoN authors
+//
+// SPDX-License-Identifier: MIT
+
+#define CATCH_CONFIG_RUNNER // Define this before including catch.hpp to create
+                            // a custom main
+#include "catch2_common.hpp"
+
+#include "NeoN/NeoN.hpp"
+
+#include <algorithm>
+
+using NeoN::toLocalIdx;
+using NeoN::finiteVolume::cellCentred::SurfaceField;
+using NeoN::finiteVolume::cellCentred::SurfaceInterpolation;
+using NeoN::finiteVolume::cellCentred::VolumeField;
+
+namespace NeoN
+{
+
+template<typename T>
+using I = std::initializer_list<T>;
+
+namespace
+{
+
+// Face values of limitedLinear (scalar) or limitedLinearV (Vec3) on a 1D uniform mesh with a
+// uniform flux of the given sign and fixed boundary values.
+template<typename ValueType>
+std::vector<ValueType> interpolate1D(
+    const Executor& exec,
+    const std::vector<ValueType>& cellValues,
+    const ValueType boundaryValue,
+    const scalar k,
+    const scalar fluxSign
+)
+{
+    auto mesh = create1DUniformMesh(exec, static_cast<localIdx>(cellValues.size()));
+    const std::string name =
+        std::is_same_v<ValueType, scalar> ? std::string("limitedLinear") : "limitedLinearV";
+    auto scheme = SurfaceInterpolation<ValueType>(exec, mesh, TokenList({name, k}));
+
+    std::vector<fvcc::VolumeBoundary<ValueType>> vbcs {};
+    std::vector<fvcc::SurfaceBoundary<ValueType>> sbcs {};
+    for (auto patchi : I<localIdx> {0, 1})
+    {
+        Dictionary dict;
+        dict.insert("type", std::string("fixedValue"));
+        dict.insert("fixedValue", boundaryValue);
+        vbcs.push_back(fvcc::VolumeBoundary<ValueType>(mesh, dict, patchi));
+        sbcs.push_back(fvcc::SurfaceBoundary<ValueType>(mesh, dict, patchi));
+    }
+
+    auto in = VolumeField<ValueType>(exec, "in", mesh, vbcs);
+    auto flux = SurfaceField<scalar>(exec, "flux", mesh, {});
+    auto out = SurfaceField<ValueType>(exec, "out", mesh, sbcs);
+
+    in.internalVector() = Vector<ValueType>(exec, cellValues);
+    in.correctBoundaryConditions();
+    fill(flux.internalVector(), fluxSign);
+
+    scheme.interpolate(flux, in, out);
+    auto host = out.internalVector().copyToHost();
+    return std::vector<ValueType>(host.view().begin(), host.view().end());
+}
+
+} // namespace
+
+TEST_CASE("limitedLinearV is registered for vector fields only")
+{
+    const auto vectorEntries = fvcc::SurfaceInterpolationFactory<Vec3>::entries();
+    const auto scalarEntries = fvcc::SurfaceInterpolationFactory<scalar>::entries();
+
+    auto has = [](const auto& entries, const std::string& key)
+    { return std::find(entries.begin(), entries.end(), key) != entries.end(); };
+
+    REQUIRE(has(vectorEntries, "limitedLinearV"));
+    REQUIRE_FALSE(has(scalarEntries, "limitedLinearV"));
+}
+
+// For U = phi * e the direction of the face difference is e everywhere, so the TVD ratio of
+// limitedLinearV equals the scalar ratio of phi: each component must equal limitedLinear(phi)*e.
+TEST_CASE("limitedLinearV reduces to limitedLinear for a field of fixed direction")
+{
+    auto [execName, exec] = GENERATE(allAvailableExecutor());
+    INFO("executor: " << execName);
+
+    const scalar k = GENERATE(1.0, 0.5);
+    const scalar fluxSign = GENERATE(1.0, -1.0);
+    INFO("k = " << k << ", flux sign = " << fluxSign);
+
+    // A step with an overshoot and a smooth part: the limiter takes all values in [0, 1].
+    const std::vector<scalar> phi {1.0, 1.0, 1.0, 0.9, 0.3, 0.1, 0.12, 0.2, 0.25, 0.27};
+    const Vec3 e(1.0, -2.0, 0.5);
+
+    std::vector<Vec3> U(phi.size());
+    std::transform(phi.begin(), phi.end(), U.begin(), [&](scalar v) { return v * e; });
+
+    const auto phiF = interpolate1D<scalar>(exec, phi, 0.5, k, fluxSign);
+    const auto UF = interpolate1D<Vec3>(exec, U, 0.5 * e, k, fluxSign);
+
+    REQUIRE(phiF.size() == UF.size());
+    for (localIdx i = 0; i < toLocalIdx(phiF.size()); ++i)
+    {
+        INFO("face " << i);
+        for (std::size_t c = 0; c < 3; ++c)
+        {
+            REQUIRE(UF[i][c] == Catch::Approx(phiF[i] * e[c]).margin(1e-12));
+        }
+    }
+}
+
+// A constant field is reproduced exactly.
+TEST_CASE("limitedLinearV preserves a constant vector field")
+{
+    auto [execName, exec] = GENERATE(allAvailableExecutor());
+    INFO("executor: " << execName);
+
+    const Vec3 u(2.0, -1.0, 3.0);
+    const std::vector<Vec3> U(8, u);
+    const auto UF = interpolate1D<Vec3>(exec, U, u, 1.0, 1.0);
+
+    for (const auto& f : UF)
+    {
+        for (std::size_t c = 0; c < 3; ++c)
+        {
+            REQUIRE(f[c] == Catch::Approx(u[c]).margin(1e-12));
+        }
+    }
+}
+
+} // namespace NeoN
