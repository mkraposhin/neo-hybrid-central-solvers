+/**
+ * @brief Replace the token list "uniform <value>" of the entry key by the scalar value.
+ *
+ * Only the uniform form is supported; a non-uniform entry is an error.
+ */
+inline void
+insertUniformScalar(NeoN::Dictionary& dict, const std::string& key, const std::string& patchName)
+{
+    if (!dict.contains(key))
+    {
+        throw std::runtime_error("Entry '" + key + "' is missing on patch '" + patchName + "'.");
+    }
+    NeoN::TokenList tokenList = dict.get<NeoN::TokenList>(key);
+    if (tokenList.size() != 2 || tokenList.get<std::string>(0) != "uniform")
+    {
+        throw std::runtime_error(
+            "Entry '" + key + "' on patch '" + patchName + "' must be 'uniform <value>'."
+        );
+    }
+    dict.insert(key, tokenAsScalar(tokenList, 1));
+}
