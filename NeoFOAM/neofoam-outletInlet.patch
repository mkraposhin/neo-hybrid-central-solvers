     std::string activePatchName;
     const Foam::fvPatch* activeFoamPatch = nullptr;
 
+    // Replaces the OpenFOAM token list of a uniform entry ("uniform x" / "uniform (x y z)") by its
+    // value, e.g. inletValue of inletOutlet and outletValue of outletInlet. A non-uniform entry
+    // yields zero.
+    auto insertUniformValue = [](NeoN::Dictionary& dict, const std::string& key)
+    {
+        NeoN::TokenList tokenList = dict.template get<NeoN::TokenList>(key);
+        if constexpr (std::is_same<type_primitive_t, NeoN::Vec3>::value)
+        {
+            NeoN::Vec3 value {};
+            if (tokenList.size() >= 4)
+            {
+                value[0] = detail::tokenAsScalar(tokenList, 1);
+                value[1] = detail::tokenAsScalar(tokenList, 2);
+                value[2] = detail::tokenAsScalar(tokenList, 3);
+            }
+            dict.insert(key, value);
+        }
+        else
+        {
+            dict.insert(
+                key,
+                tokenList.size() >= 2 ? detail::tokenAsScalar(tokenList, 1) : type_primitive_t {}
+            );
+        }
+    };
+
